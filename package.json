{
 "name": "@octopus-synapse/profile-frontend",
 "version": "1.0.0",
 "private": true,
 "packageManager": "pnpm@9.15.0",
 "scripts": {
  "dev": "pnpm --filter @profile/web dev",
  "build": "pnpm --filter @profile/web build",
  "start": "pnpm --filter @profile/web start",
  "lint": "pnpm -r lint",
  "lint:fix": "pnpm -r lint:fix",
  "format": "pnpm -r format",
  "format:check": "pnpm -r format:check",
  "type-check": "pnpm -r type-check",
  "test": "pnpm -r test",
  "clean": "pnpm -r clean && rm -rf node_modules",
  "prepare": "husky"
 },
 "devDependencies": {
  "@commitlint/cli": "^20.3.0",
  "@commitlint/config-conventional": "^20.3.0",
  "husky": "^9.1.7",
  "lint-staged": "^16.2.7",
  "prettier": "^3.7.4",
  "typescript": "^5.7.2"
 },
 "lint-staged": {
  "*.{ts,tsx}": [
   "prettier --write"
  ],
  "*.{css,json,md,yaml}": [
   "prettier --write"
  ]
 },
 "engines": {
  "node": ">=20.0.0",
  "pnpm": ">=9.0.0"
 },
 "dependencies": {
  "@octopus-synapse/profile-contracts": "link:../profile-contracts"
 }
}
