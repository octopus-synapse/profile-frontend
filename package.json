{
 "name": "profile-frontend",
 "version": "1.1.0",
 "private": true,
 "workspaces": [
  "apps/*",
  "packages/*"
 ],
 "scripts": {
  "dev": "bun --filter @profile/web dev",
  "dev:mobile": "bun --filter @profile/mobile start",
  "build": "bun --filter @profile/api-client build && bun --filter @profile/stores build && bun --filter @profile/i18n build && bun --filter @profile/web build",
  "start": "bun --filter @profile/web start",
  "lint": "biome check .",
  "lint:fast": "biome check .",
  "lint:fix": "biome check --write .",
  "format": "biome format --write .",
  "format:check": "biome format .",
  "typecheck": "tsc --noEmit",
  "test": "bun test",
  "test:unit": "bun test packages/",
  "test:arch": "bun test test/architecture/",
  "test:smoke": "bun test --config=bunfig.smoke.toml",
  "test:e2e": "bun test --config=bunfig.e2e.toml test/e2e/",
  "test:watch": "bun test --watch",
  "test:coverage": "bun test --coverage",
  "precommit": "bun run typecheck && bun run lint:fast && bun run test:unit",
  "ci:lint": "bun run lint",
  "ci:test": "bun run test:e2e",
  "clean": "bun -r clean && rm -rf node_modules",
  "prepare": "husky"
 },
 "devDependencies": {
  "@biomejs/biome": "2.3.14",
  "@commitlint/cli": "^20.3.0",
  "@commitlint/config-conventional": "^20.3.0",
  "@types/bun": "latest",
  "@types/react": "^19",
  "@types/react-dom": "^19",
  "husky": "^9.1.7",
  "typescript": "^5.7.2"
 },
 "engines": {
  "bun": "1.3.9"
 },
 "overrides": {
  "react": "^19.0.0",
  "react-dom": "^19.0.0"
 }
}
