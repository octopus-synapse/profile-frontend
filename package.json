{
 "name": "profile-banner",
 "version": "0.1.0",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "lint": "next lint",
  "lint:fix": "next lint --fix",
  "format": "prettier --write .",
  "format:check": "prettier --check .",
  "typecheck": "tsc --noEmit",
  "test": "jest",
  "test:watch": "jest --watch",
  "test:coverage": "jest --coverage",
  "test:integration": "jest --testPathPattern=integration",
  "test:unit": "jest --testPathPattern='(stores|api|components)/__tests__'",
  "test:e2e": "jest --testPathPattern=e2e",
  "analyze": "ANALYZE=true next build",
  "analyze:start": "ANALYZE=true next build && next start",
  "docker:build": "docker build -t profile-frontend .",
  "docker:run": "docker run -p 3000:3000 --env-file .env profile-frontend",
  "docker:up": "docker-compose up -d",
  "docker:down": "docker-compose down",
  "docker:logs": "docker-compose logs -f frontend"
 },
 "dependencies": {
  "@dnd-kit/core": "^6.3.1",
  "@dnd-kit/sortable": "^10.0.0",
  "@dnd-kit/utilities": "^3.2.2",
  "@headlessui/react": "^2.2.4",
  "@hookform/resolvers": "^3.9.0",
  "@react-pdf/renderer": "^4.2.0",
  "axios": "^1.6.2",
  "clsx": "^2.1.1",
  "framer-motion": "^12.19.1",
  "lucide-react": "^0.552.0",
  "next": "15.3.4",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "react-hook-form": "^7.53.0",
  "react-hot-toast": "^2.5.2",
  "react-icons": "^5.5.0",
  "zod": "^3.25.76",
  "zustand": "^5.0.0"
 },
 "devDependencies": {
  "@eslint/eslintrc": "^3",
  "@next/bundle-analyzer": "^13.3.0",
  "@tailwindcss/postcss": "^4.1.10",
  "@testing-library/jest-dom": "^6.1.5",
  "@testing-library/react": "^14.1.2",
  "@testing-library/user-event": "^14.5.1",
  "@types/jest": "^29.5.11",
  "@types/node": "^20",
  "@types/react": "^19",
  "@types/react-dom": "^19",
  "@types/uuid": "^10.0.0",
  "autoprefixer": "^10.4.21",
  "eslint": "^9",
  "eslint-config-next": "15.3.4",
  "jest": "^29.7.0",
  "jest-environment-jsdom": "^29.7.0",
  "msw": "^2.0.0",
  "postcss": "^8.5.6",
  "prettier": "^3.1.0",
  "tailwindcss": "^4.1.10",
  "ts-node": "^10.9.2",
  "typescript": "^5"
 }
}
