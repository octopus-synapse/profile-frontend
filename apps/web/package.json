{
  "name": "@profile/web",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "node --require ./polyfill-localstorage.js ../../node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check src/",
    "lint:fast": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/ || true",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "precommit": "bun run typecheck && bun run lint:fast",
    "ci:lint": "bun run lint",
    "clean": "rm -rf .next .turbo node_modules playwright-report test-results"
  },
  "dependencies": {
    "@octopus-synapse/profile-ui": "../../../profile-ui",
    "@profile/api-client": "workspace:*",
    "@profile/i18n": "workspace:*",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@tanstack/react-query": "^5.90.12",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next": "15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.2"
  }
}
