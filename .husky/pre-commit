#!/bin/sh
# Standardized pre-commit hook for ProFile repositories
# Source: octopus-workflows/scripts/husky/pre-commit
#
# Run order:
# 1. Type check
# 2. Fast lint
# 3. Unit tests
# 4. Smoke tests
#
# CI will run additional checks:
# - Full lint with biome
# - Architecture tests
# - Integration tests

echo "Pre-commit checks (fast feedback loop)..."
echo ""

# 1. Type check
echo "  -> Type checking..."
bun run typecheck || exit 1

# 2. Fast lint with biome
echo "  -> Fast lint (biome)..."
bun run lint:fast || exit 1

# 3. Unit tests
echo "  -> Running unit tests..."
bun run test:unit || exit 1

# 4. Smoke tests
echo "  -> Running smoke tests..."
bun run test:smoke || exit 1

echo ""
echo "Pre-commit passed!"
