/**
 * useAuth Hook Tests
 *
 * Following Kent Beck's TDD principles:
 * - Tests describe observable behavior
 * - Tests are independent and repeatable
 *
 * Following Uncle Bob's clean testing principles:
 * - One concept per test
 * - Given-When-Then structure
 */

import { describe, it, expect, mock, beforeEach } from "bun:test";
import { renderHook, act, waitFor } from "@testing-library/react";
import { useAuth } from "../useAuth";
import type { AuthStore } from "@profile/stores";

// Mock store factory - Single Responsibility Principle
const createMockStore = (overrides: Partial<AuthStore> = {}): AuthStore => ({
 user: null,
 tokens: null,
 isAuthenticated: false,
 isLoading: false,
 error: null,
 setUser: mock(() => {}),
 setTokens: mock(() => {}),
 setLoading: mock(() => {}),
 setError: mock(() => {}),
 login: mock(() => Promise.resolve()),
 register: mock(() => Promise.resolve()),
 logout: mock(() => Promise.resolve()),
 refreshToken: mock(() => Promise.resolve()),
 clearAuth: mock(() => {}),
 ...overrides,
});

describe("useAuth", () => {
 describe("Initial State", () => {
  it("should return user from store", () => {
   const mockUser = { id: "1", email: "test@example.com" };
   const store = createMockStore({ user: mockUser as any });

   const { result } = renderHook(() => useAuth({ store }));

   expect(result.current.user).toEqual(mockUser);
  });

  it("should return isAuthenticated from store", () => {
   const store = createMockStore({ isAuthenticated: true });

   const { result } = renderHook(() => useAuth({ store }));

   expect(result.current.isAuthenticated).toBe(true);
  });

  it("should return isLoading from store", () => {
   const store = createMockStore({ isLoading: true });

   const { result } = renderHook(() => useAuth({ store }));

   expect(result.current.isLoading).toBe(true);
  });

  it("should return error from store", () => {
   const store = createMockStore({ error: "Test error" });

   const { result } = renderHook(() => useAuth({ store }));

   expect(result.current.error).toBe("Test error");
  });
 });

 describe("login", () => {
  it("should call store login with credentials", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useAuth({ store }));

   await act(async () => {
    await result.current.login("test@example.com", "password123");
   });

   expect(store.login).toHaveBeenCalledWith("test@example.com", "password123");
  });

  it("should call onLoginSuccess on successful login", async () => {
   const store = createMockStore();
   const onLoginSuccess = mock(() => {});

   const { result } = renderHook(() => useAuth({ store, onLoginSuccess }));

   await act(async () => {
    await result.current.login("test@example.com", "password");
   });

   expect(onLoginSuccess).toHaveBeenCalled();
  });

  it("should not call onLoginSuccess on failed login", async () => {
   const store = createMockStore({
    login: mock(() => Promise.reject(new Error("Invalid credentials"))),
   });
   const onLoginSuccess = mock(() => {});

   const { result } = renderHook(() => useAuth({ store, onLoginSuccess }));

   await act(async () => {
    await result.current.login("test@example.com", "wrong");
   });

   expect(onLoginSuccess).not.toHaveBeenCalled();
  });
 });

 describe("register", () => {
  it("should call store register with data", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useAuth({ store }));

   await act(async () => {
    await result.current.register("new@example.com", "password", "newuser");
   });

   expect(store.register).toHaveBeenCalledWith(
    "new@example.com",
    "password",
    "newuser"
   );
  });

  it("should call onLoginSuccess on successful registration", async () => {
   const store = createMockStore();
   const onLoginSuccess = mock(() => {});

   const { result } = renderHook(() => useAuth({ store, onLoginSuccess }));

   await act(async () => {
    await result.current.register("new@example.com", "password", "newuser");
   });

   expect(onLoginSuccess).toHaveBeenCalled();
  });
 });

 describe("logout", () => {
  it("should call store logout", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useAuth({ store }));

   await act(async () => {
    await result.current.logout();
   });

   expect(store.logout).toHaveBeenCalled();
  });

  it("should call onLogoutSuccess on successful logout", async () => {
   const store = createMockStore();
   const onLogoutSuccess = mock(() => {});

   const { result } = renderHook(() => useAuth({ store, onLogoutSuccess }));

   await act(async () => {
    await result.current.logout();
   });

   expect(onLogoutSuccess).toHaveBeenCalled();
  });
 });

 describe("clearError", () => {
  it("should call store setError with null", () => {
   const store = createMockStore({ error: "Some error" });
   const { result } = renderHook(() => useAuth({ store }));

   act(() => {
    result.current.clearError();
   });

   expect(store.setError).toHaveBeenCalledWith(null);
  });
 });

 describe("onError callback", () => {
  it("should call onError when store has error", async () => {
   const store = createMockStore({ error: "Initial error" });
   const onError = mock(() => {});

   renderHook(() => useAuth({ store, onError }));

   // Wait for useEffect to run
   await waitFor(() => {
    expect(onError).toHaveBeenCalledWith("Initial error");
   });
  });
 });
});
