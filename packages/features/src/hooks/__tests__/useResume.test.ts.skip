/**
 * useResume Hook Tests
 *
 * Tests focus on hook behavior, not implementation.
 * Each test represents a real use case.
 */

import { describe, it, expect, mock, beforeEach } from "bun:test";
import { renderHook, act, waitFor } from "@testing-library/react";
import { useResume } from "../useResume";
import type { ResumeStore } from "@profile/stores";

// Mock resume data
const mockResume = {
 id: "resume-1",
 title: "My Resume",
 slug: "my-resume",
 userId: "user-1",
 isPublic: false,
 createdAt: new Date().toISOString(),
 updatedAt: new Date().toISOString(),
};

// Mock store factory
const createMockStore = (
 overrides: Partial<ResumeStore> = {}
): ResumeStore => ({
 resumes: [],
 currentResume: null,
 isLoading: false,
 error: null,
 setResumes: mock(() => {}),
 setCurrentResume: mock(() => {}),
 setLoading: mock(() => {}),
 setError: mock(() => {}),
 fetchResumes: mock(() => Promise.resolve()),
 fetchResume: mock(() => Promise.resolve()),
 createResume: mock(() => Promise.resolve(mockResume as any)),
 updateResume: mock(() => Promise.resolve()),
 deleteResume: mock(() => Promise.resolve()),
 clearError: mock(() => {}),
 ...overrides,
});

describe("useResume", () => {
 describe("Initial State", () => {
  it("should return resumes from store", () => {
   const store = createMockStore({ resumes: [mockResume] as any });

   const { result } = renderHook(() => useResume({ store }));

   expect(result.current.resumes).toHaveLength(1);
  });

  it("should return currentResume from store", () => {
   const store = createMockStore({ currentResume: mockResume as any });

   const { result } = renderHook(() => useResume({ store }));

   expect(result.current.currentResume).toEqual(mockResume);
  });

  it("should return loading state", () => {
   const store = createMockStore({ isLoading: true });

   const { result } = renderHook(() => useResume({ store }));

   expect(result.current.isLoading).toBe(true);
  });
 });

 describe("Auto Fetch", () => {
  it("should fetch resumes when autoFetch is true", async () => {
   const store = createMockStore();

   renderHook(() => useResume({ store, autoFetch: true }));

   await waitFor(() => {
    expect(store.fetchResumes).toHaveBeenCalled();
   });
  });

  it("should not fetch when autoFetch is false", async () => {
   const store = createMockStore();

   renderHook(() => useResume({ store, autoFetch: false }));

   // Give it time to potentially call
   await new Promise((resolve) => setTimeout(resolve, 50));

   expect(store.fetchResumes).not.toHaveBeenCalled();
  });

  it("should not fetch when already loading", async () => {
   const store = createMockStore({ isLoading: true });

   renderHook(() => useResume({ store, autoFetch: true }));

   await new Promise((resolve) => setTimeout(resolve, 50));

   expect(store.fetchResumes).not.toHaveBeenCalled();
  });

  it("should not fetch when resumes already exist", async () => {
   const store = createMockStore({ resumes: [mockResume] as any });

   renderHook(() => useResume({ store, autoFetch: true }));

   await new Promise((resolve) => setTimeout(resolve, 50));

   expect(store.fetchResumes).not.toHaveBeenCalled();
  });
 });

 describe("fetchResumes", () => {
  it("should call store fetchResumes", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   await act(async () => {
    await result.current.fetchResumes();
   });

   expect(store.fetchResumes).toHaveBeenCalled();
  });

  it("should call onSuccess callback", async () => {
   const store = createMockStore();
   const onSuccess = mock(() => {});

   const { result } = renderHook(() => useResume({ store, onSuccess }));

   await act(async () => {
    await result.current.fetchResumes();
   });

   expect(onSuccess).toHaveBeenCalledWith("fetchResumes");
  });
 });

 describe("createResume", () => {
  it("should call store createResume with data", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   await act(async () => {
    await result.current.createResume({ title: "New", slug: "new" });
   });

   expect(store.createResume).toHaveBeenCalledWith({
    title: "New",
    slug: "new",
   });
  });

  it("should return created resume", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   let created;
   await act(async () => {
    created = await result.current.createResume({ title: "New", slug: "new" });
   });

   expect(created).toBeDefined();
  });
 });

 describe("updateResume", () => {
  it("should call store updateResume with id and data", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   await act(async () => {
    await result.current.updateResume("resume-1", { title: "Updated" });
   });

   expect(store.updateResume).toHaveBeenCalledWith("resume-1", {
    title: "Updated",
   });
  });
 });

 describe("deleteResume", () => {
  it("should call store deleteResume with id", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   await act(async () => {
    await result.current.deleteResume("resume-1");
   });

   expect(store.deleteResume).toHaveBeenCalledWith("resume-1");
  });
 });

 describe("selectResume", () => {
  it("should call store fetchResume with id", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   await act(async () => {
    await result.current.selectResume("resume-1");
   });

   expect(store.fetchResume).toHaveBeenCalledWith("resume-1");
  });
 });

 describe("clearError", () => {
  it("should call store clearError", () => {
   const store = createMockStore();
   const { result } = renderHook(() => useResume({ store }));

   act(() => {
    result.current.clearError();
   });

   expect(store.clearError).toHaveBeenCalled();
  });
 });

 describe("Error Handling", () => {
  it("should call onError when store has error", async () => {
   const store = createMockStore({ error: "Something went wrong" });
   const onError = mock(() => {});

   renderHook(() => useResume({ store, onError }));

   await waitFor(() => {
    expect(onError).toHaveBeenCalledWith("Something went wrong");
   });
  });
 });
});
