/**
 * useTheme Hook Tests
 *
 * Tests theme management functionality.
 */

import { describe, it, expect, mock } from "bun:test";
import { renderHook, act, waitFor } from "@testing-library/react";
import { useTheme } from "../useTheme";
import type { ThemeStore } from "@profile/stores";

const mockTheme = {
 id: "theme-1",
 name: "Default Theme",
 category: "professional",
 status: "approved",
 styleConfig: {},
 tags: [],
 isSystem: false,
};

const createMockStore = (overrides: Partial<ThemeStore> = {}): ThemeStore => ({
 themes: [],
 myThemes: [],
 systemThemes: [],
 popularThemes: [],
 currentTheme: null,
 pendingApprovals: [],
 isLoading: false,
 error: null,
 setThemes: mock(() => {}),
 setCurrentTheme: mock(() => {}),
 setLoading: mock(() => {}),
 setError: mock(() => {}),
 clearError: mock(() => {}),
 fetchThemes: mock(() => Promise.resolve()),
 fetchMyThemes: mock(() => Promise.resolve()),
 fetchSystemThemes: mock(() => Promise.resolve()),
 fetchPopularThemes: mock(() => Promise.resolve()),
 fetchTheme: mock(() => Promise.resolve()),
 createTheme: mock(() => Promise.resolve(mockTheme as any)),
 updateTheme: mock(() => Promise.resolve()),
 deleteTheme: mock(() => Promise.resolve()),
 forkTheme: mock(() => Promise.resolve(mockTheme as any)),
 applyToResume: mock(() => Promise.resolve()),
 submitForApproval: mock(() => Promise.resolve()),
 fetchPendingApprovals: mock(() => Promise.resolve()),
 approveTheme: mock(() => Promise.resolve()),
 rejectTheme: mock(() => Promise.resolve()),
 ...overrides,
});

describe("useTheme", () => {
 describe("Initial State", () => {
  it("should return themes from store", () => {
   const store = createMockStore({ themes: [mockTheme] as any });

   const { result } = renderHook(() => useTheme({ store }));

   expect(result.current.themes).toHaveLength(1);
  });

  it("should return myThemes from store", () => {
   const store = createMockStore({ myThemes: [mockTheme] as any });

   const { result } = renderHook(() => useTheme({ store }));

   expect(result.current.myThemes).toHaveLength(1);
  });

  it("should return currentTheme from store", () => {
   const store = createMockStore({ currentTheme: mockTheme as any });

   const { result } = renderHook(() => useTheme({ store }));

   expect(result.current.currentTheme).toEqual(mockTheme);
  });
 });

 describe("Auto Fetch", () => {
  it("should fetch system themes when autoFetchSystem is true", async () => {
   const store = createMockStore();

   renderHook(() => useTheme({ store, autoFetchSystem: true }));

   await waitFor(() => {
    expect(store.fetchSystemThemes).toHaveBeenCalled();
   });
  });

  it("should fetch my themes when autoFetchMine is true", async () => {
   const store = createMockStore();

   renderHook(() => useTheme({ store, autoFetchMine: true }));

   await waitFor(() => {
    expect(store.fetchMyThemes).toHaveBeenCalled();
   });
  });
 });

 describe("fetchThemes", () => {
  it("should call store fetchThemes with params", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.fetchThemes({ category: "creative" });
   });

   expect(store.fetchThemes).toHaveBeenCalledWith({ category: "creative" });
  });

  it("should call onSuccess callback", async () => {
   const store = createMockStore();
   const onSuccess = mock(() => {});

   const { result } = renderHook(() => useTheme({ store, onSuccess }));

   await act(async () => {
    await result.current.fetchThemes();
   });

   expect(onSuccess).toHaveBeenCalledWith("fetchThemes");
  });
 });

 describe("createTheme", () => {
  it("should call store createTheme", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.createTheme({
     name: "New Theme",
     category: "modern",
     styleConfig: {},
    });
   });

   expect(store.createTheme).toHaveBeenCalledWith({
    name: "New Theme",
    category: "modern",
    styleConfig: {},
   });
  });

  it("should return created theme", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   let created;
   await act(async () => {
    created = await result.current.createTheme({
     name: "New",
     category: "modern",
     styleConfig: {},
    });
   });

   expect(created).toBeDefined();
   expect(created.name).toBe("Default Theme"); // from mock
  });
 });

 describe("forkTheme", () => {
  it("should call store forkTheme with id and name", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.forkTheme("theme-1", "My Fork");
   });

   expect(store.forkTheme).toHaveBeenCalledWith("theme-1", "My Fork");
  });
 });

 describe("applyToResume", () => {
  it("should call store applyToResume", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.applyToResume("resume-1", "theme-1");
   });

   expect(store.applyToResume).toHaveBeenCalledWith("resume-1", "theme-1");
  });
 });

 describe("Approval Workflow", () => {
  it("should submit theme for approval", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.submitForApproval("theme-1");
   });

   expect(store.submitForApproval).toHaveBeenCalledWith("theme-1");
  });

  it("should approve theme", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.approveTheme("theme-1");
   });

   expect(store.approveTheme).toHaveBeenCalledWith("theme-1");
  });

  it("should reject theme with reason", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.rejectTheme("theme-1", "Not appropriate");
   });

   expect(store.rejectTheme).toHaveBeenCalledWith("theme-1", "Not appropriate");
  });
 });

 describe("selectTheme", () => {
  it("should call store fetchTheme", async () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   await act(async () => {
    await result.current.selectTheme("theme-1");
   });

   expect(store.fetchTheme).toHaveBeenCalledWith("theme-1");
  });
 });

 describe("clearError", () => {
  it("should call store clearError", () => {
   const store = createMockStore();
   const { result } = renderHook(() => useTheme({ store }));

   act(() => {
    result.current.clearError();
   });

   expect(store.clearError).toHaveBeenCalled();
  });
 });
});
