{
 "name": "@profile/features",
 "version": "0.1.0",
 "description": "Shared feature hooks for web and mobile",
 "main": "./dist/index.js",
 "module": "./dist/index.mjs",
 "types": "./dist/index.d.ts",
 "exports": {
  ".": {
   "import": "./dist/index.mjs",
   "require": "./dist/index.js",
   "types": "./dist/index.d.ts"
  }
 },
 "scripts": {
  "build": "tsup",
  "dev": "tsup --watch",
  "typecheck": "tsc --noEmit",
