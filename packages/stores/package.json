{
 "name": "@profile/stores",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "main": "./dist/index.cjs",
 "module": "./dist/index.js",
 "types": "./dist/index.d.ts",
 "exports": {
  ".": {
   "import": "./dist/index.js",
   "require": "./dist/index.cjs",
   "types": "./dist/index.d.ts"
  }
 },
 "scripts": {
  "dev": "tsup --watch",
  "build": "tsup",
  "clean": "rm -rf dist",
  "typecheck": "tsc --noEmit",
  "lint": "biome check src/",
  "lint:fix": "biome check --write src/",
  "test": "bun test",
  "test:watch": "bun test --watch",
  "test:coverage": "bun test --coverage",
  "precommit": "bun run typecheck && bun run lint"
 },
 "dependencies": {
  "@profile/api-client": "workspace:*",
  "zustand": "^5.0.2"
 },
 "devDependencies": {
  "@types/bun": "latest",
  "typescript": "^5.7.2",
  "tsup": "^8.3.5"
 },
 "peerDependencies": {
  "react": "^19.0.0"
 }
}
