{
 "name": "@profile/api-client",
 "version": "1.0.0",
 "private": true,
 "description": "Profile API client - framework agnostic HTTP client and repositories",
 "main": "./dist/index.js",
 "module": "./dist/index.mjs",
 "types": "./dist/index.d.ts",
 "exports": {
  ".": {
   "types": "./dist/index.d.ts",
   "import": "./dist/index.mjs",
   "require": "./dist/index.js"
  },
  "./repositories": {
   "types": "./dist/repositories/index.d.ts",
   "import": "./dist/repositories/index.mjs",
   "require": "./dist/repositories/index.js"
  },
  "./types": {
   "types": "./dist/types/index.d.ts",
   "import": "./dist/types/index.mjs",
   "require": "./dist/types/index.js"
  },
  "./errors": {
   "types": "./dist/errors/index.d.ts",
   "import": "./dist/errors/index.mjs",
   "require": "./dist/errors/index.js"
  },
  "./client": {
   "types": "./dist/client/index.d.ts",
   "import": "./dist/client/index.mjs",
   "require": "./dist/client/index.js"
  }
 },
 "files": [
  "dist",
  "src"
 ],
 "scripts": {
  "build": "tsup",
  "dev": "tsup --watch",
  "lint": "eslint src --ext .ts",
  "lint:fix": "eslint src --ext .ts --fix",
  "type-check": "tsc --noEmit",
  "clean": "rm -rf dist node_modules"
 },
 "dependencies": {
  "axios": "^1.13.2"
 },
 "devDependencies": {
  "@eslint/js": "^9.39.2",
  "@types/node": "^20",
  "eslint": "^9",
  "tsup": "^8.3.5",
  "typescript": "^5.7.2",
  "typescript-eslint": "^8.50.1"
 },
 "peerDependencies": {
  "typescript": ">=5.0.0"
 }
}
