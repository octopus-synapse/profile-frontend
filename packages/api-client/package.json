{
  "name": "@profile/api-client",
  "version": "2.1.0",
  "private": true,
  "description": "Profile API SDK - auto-generated from backend OpenAPI spec",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.mjs",
      "require": "./dist/constants/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "sdk:generate": "orval --config orval.config.ts && bun run scripts/generate-barrel.ts && bun run scripts/generate-routes.ts",
    "sdk:watch": "orval --config orval.config.ts --watch",
    "precommit": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "zod": "3.23.8"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.90.20",
    "@types/bun": "latest",
    "@types/node": "^20",
    "orval": "^8.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
